<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Phai trung TargetFramework cua VcbPortalApi.csproj. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VcbPortalApi\VcbPortalApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!-- DB chay trong bo nho, de test controller co dung DbContext. Version phai cung
         dong voi Microsoft.EntityFrameworkCore ma VcbPortalApi dang dung. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
  </ItemGroup>

  <!--
    Code nguon viet cho Microsoft.NET.Sdk.Web, SDK do tu them san mot loat using
    (ILogger, StatusCodes...). Project test dung Microsoft.NET.Sdk thuong nen khong co,
    phai khai lai, neu khong se loi CS0246 khi test cham toi controller.
  -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
