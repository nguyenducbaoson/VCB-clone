<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Phai trung TargetFramework cua VcbPortalApi.csproj. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VcbPortalApi\VcbPortalApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />

    <PackageReference Include="Moq" Version="4.20.72" />

    <!--
      GHIM 7.x CO CHU Y. Tu FluentAssertions 8.0 tro di, Xceed doi sang giay phep
      thuong mai: dung trong san pham thuong mai phai mua license. 7.2.0 la ban cuoi
      con Apache 2.0, mien phi. DUNG nang len 8.x neu chua co license.
      Thay the mien phi neu can: AwesomeAssertions (fork cua 7.x).
    -->
    <PackageReference Include="FluentAssertions" Version="7.2.0" />

    <!-- DB chay trong bo nho, de test service/controller co dung DbContext. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
  </ItemGroup>

  <!--
    Code nguon viet cho Microsoft.NET.Sdk.Web, SDK do tu them san mot loat using
    (ILogger, StatusCodes...). Project test dung Microsoft.NET.Sdk thuong nen phai khai lai.
  -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="Moq" />
  </ItemGroup>

</Project>
