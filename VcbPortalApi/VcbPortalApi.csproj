<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Solution that con Startup.cs + NLog nen nhieu kha nang la net6.0/net8.0.
         Ban khung nay dung net10.0 vi day la SDK co san tren may. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VcbPortalApi</RootNamespace>
  </PropertyGroup>

  <!-- De test kiem duoc phan dung phong bi ACQHUB (BuildEnvelope/ComputeCheckSum)
       ma khong phai mo chung thanh public. Day la chi tiet noi bo cua client,
       nhung lai la thu dang kiem nhat trong ca luong. -->
  <ItemGroup>
    <InternalsVisibleTo Include="VcbPortalApi.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.58" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
